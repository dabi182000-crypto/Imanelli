{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

<style>
  .imanelli-newsletter,
  .imanelli-newsletter::before,
  .imanelli-newsletter::after,
  .imanelli-newsletter > .page-width,
  .imanelli-newsletter__inner,
  .imanelli-newsletter .newsletter-form,
  .imanelli-newsletter .newsletter-form__field-wrapper,
  .imanelli-newsletter .field,
  .imanelli-newsletter .field__input {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    background-image: none !important;
  }

  .imanelli-newsletter__inner {
    box-shadow: none !important;
    backdrop-filter: none !important;
  }
</style>

<section class="imanelli-section imanelli-newsletter" style="background:#FFFFFF !important; background-image:none !important;">
  <div class="page-width" style="background:#FFFFFF !important;">
    <div class="imanelli-newsletter__inner" style="background:#FFFFFF !important; background-image:none !important;">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="imanelli-newsletter__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="imanelli-newsletter__copy">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      {%- form 'customer', id: 'ImanelliNewsletter', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <input
              id="ImanelliNewsletterEmail--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="ImanelliNewsletter-error"
              {% elsif form.posted_successfully? %}
                aria-describedby="ImanelliNewsletter-success"
              {% endif %}
              placeholder="{{ section.settings.placeholder | escape }}"
              required
            >
            <label class="field__label" for="ImanelliNewsletterEmail--{{ section.id }}">
              {{ section.settings.placeholder | escape }}
            </label>
            <button class="imanelli-newsletter__submit" type="submit" name="commit">
              {{ section.settings.button_label | escape }}
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="ImanelliNewsletter-error">
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>
        {%- if form.posted_successfully? -%}
          <h3 class="newsletter-form__message newsletter-form__message--success form__message" id="ImanelliNewsletter-success" tabindex="-1" autofocus>
            {{ section.settings.success_message | escape }}
          </h3>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imanelli newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the know"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "New arrivals, exclusive previews and private edits."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for joining Imanelli Couture."
    }
  ],
  "presets": [
    {
      "name": "Imanelli newsletter"
    }
  ]
}
{% endschema %}
