<section class="imanelli-section imanelli-collection-tiles">
  <div class="page-width">
    <div class="imanelli-section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="imanelli-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="imanelli-section-heading__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="imanelli-text-link" href="{{ section.settings.link | default: routes.collections_url }}">
          {{ section.settings.link_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="imanelli-collection-tiles__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_link = block.settings.link | default: routes.collections_url
          if forloop.index == 1
            assign fallback_asset = 'imanellicouture-everyday.webp'
            assign fallback_alt = 'Woman wearing a refined everyday black abaya'
          else
            assign fallback_asset = 'imanellicouture-occasion.webp'
            assign fallback_alt = 'Woman wearing an embroidered black occasion abaya'
          endif
          assign tile_alt = block.settings.image_alt | default: fallback_alt
        -%}
        <a class="imanelli-tile" href="{{ tile_link }}" {{ block.shopify_attributes }}>
          <div class="imanelli-tile__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  widths: '550, 750, 1100, 1500, 1800',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: tile_alt
              }}
            {%- else -%}
              <img
                src="{{ fallback_asset | asset_url }}"
                width="1200"
                height="1500"
                loading="lazy"
                alt="{{ tile_alt | escape }}"
              >
            {%- endif -%}
          </div>
          <div class="imanelli-tile__overlay" aria-hidden="true"></div>
          <div class="imanelli-tile__content">
            {%- if block.settings.heading != blank -%}
              <h3 class="imanelli-tile__title">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <span class="imanelli-text-link imanelli-tile__link">{{ block.settings.link_label | escape }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imanelli collection tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated for every moment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Top link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Top link"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Everyday elegance"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Discover collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Imanelli collection tiles",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "heading": "Everyday elegance"
          }
        },
        {
          "type": "collection",
          "settings": {
            "heading": "Occasion edit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
