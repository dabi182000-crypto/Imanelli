{%- liquid
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign button_link = section.settings.button_link | default: routes.all_products_collection_url
-%}

<section
  class="imanelli-section imanelli-hero"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-text: {{ section.settings.text_color }}; min-height: {{ section.settings.desktop_height }}px;"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="imanelli-hero__media">
    {%- if hero_image != blank -%}
      <picture>
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w"
          >
        {%- endif -%}
        {{
          hero_image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2500, 3000',
            sizes: '100vw',
            fetchpriority: 'high',
            loading: 'eager',
            alt: section.settings.image_alt
        }}
      </picture>
    {%- else -%}
      <img
        src="{{ 'imanellicouture-hero.webp' | asset_url }}"
        width="2200"
        height="1467"
        loading="eager"
        fetchpriority="high"
        alt="{{ section.settings.image_alt | escape }}"
      >
    {%- endif -%}
  </div>
  <div class="imanelli-hero__veil" aria-hidden="true"></div>
  <div class="imanelli-hero__content-wrap page-width">
    <div class="imanelli-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="imanelli-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="imanelli-hero__title">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="imanelli-hero__copy rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button imanelli-hero__button" href="{{ button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imanelli editorial hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Woman wearing an elegant Imanelli Couture abaya"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Imanelli Couture"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The New Edit"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Modern abayas, shaped by quiet confidence.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Desktop text color",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Desktop overlay opacity",
      "default": 5
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 560,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 740
    }
  ],
  "presets": [
    {
      "name": "Imanelli editorial hero"
    }
  ]
}
{% endschema %}
